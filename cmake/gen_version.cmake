# Generates fw_version.h (run at every build via `cmake -P`).
#
# Inputs (-D): OUT, SRC_DIR, VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH
# The file is only rewritten when its content changes, so an unchanged
# commit does not trigger a rebuild.

find_package(Git QUIET)
set(GIT_HASH "nogit")
set(GIT_TIME "0")
if(GIT_FOUND)
  execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse --short=8 HEAD
                  WORKING_DIRECTORY "${SRC_DIR}"
                  OUTPUT_VARIABLE _hash OUTPUT_STRIP_TRAILING_WHITESPACE
                  RESULT_VARIABLE _r1 ERROR_QUIET)
  if(_r1 EQUAL 0 AND _hash)
    set(GIT_HASH "${_hash}")
    execute_process(COMMAND "${GIT_EXECUTABLE}" status --porcelain --untracked-files=no
                    WORKING_DIRECTORY "${SRC_DIR}"
                    OUTPUT_VARIABLE _dirty OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(_dirty)
      set(GIT_HASH "${GIT_HASH}+")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" log -1 --format=%ct
                    WORKING_DIRECTORY "${SRC_DIR}"
                    OUTPUT_VARIABLE _ct OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(_ct)
      set(GIT_TIME "${_ct}")
    endif()
  endif()
endif()

if(GIT_TIME STREQUAL "0")
  string(TIMESTAMP GIT_TIME "%s" UTC)
endif()

math(EXPR FW_VERSION_U32 "(${VERSION_MAJOR} << 16) | (${VERSION_MINOR} << 8) | ${VERSION_PATCH}")

set(_content "/* generated by cmake/gen_version.cmake - do not edit */
#ifndef FW_VERSION_H
#define FW_VERSION_H
#define FW_VERSION_MAJOR    ${VERSION_MAJOR}u
#define FW_VERSION_MINOR    ${VERSION_MINOR}u
#define FW_VERSION_PATCH    ${VERSION_PATCH}u
#define FW_VERSION          ${FW_VERSION_U32}u
#define FW_VERSION_STR      \"${VERSION_MAJOR}.${VERSION_MINOR}.${VERSION_PATCH}\"
#define FW_GIT_HASH         \"${GIT_HASH}\"
#define FW_BUILD_TIME       ${GIT_TIME}u
#endif
")

if(EXISTS "${OUT}")
  file(READ "${OUT}" _old)
else()
  set(_old "")
endif()
if(NOT _old STREQUAL _content)
  file(WRITE "${OUT}" "${_content}")
endif()
